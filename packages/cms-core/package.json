{
  "name": "@kitsune/cms-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "default": "./src/db/index.ts"
    },
    "./db/schema": {
      "types": "./src/db/schema.ts",
      "default": "./src/db/schema.ts"
    },
    "./auth/workos": {
      "types": "./src/auth/workos.ts",
      "default": "./src/auth/workos.ts"
    },
    "./auth/api-keys": {
      "types": "./src/auth/api-keys.ts",
      "default": "./src/auth/api-keys.ts"
    },
    "./services/*": {
      "types": "./src/services/*.ts",
      "default": "./src/services/*.ts"
    },
    "./storage/driver": {
      "types": "./src/storage/driver.ts",
      "default": "./src/storage/driver.ts"
    },
    "./storage/local-fs": {
      "types": "./src/storage/local-fs.ts",
      "default": "./src/storage/local-fs.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/seed.ts"
  },
  "dependencies": {
    "@kitsune/schema": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@kitsune/tsconfig": "workspace:*",
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.7.2"
  }
}
