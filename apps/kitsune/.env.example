# Copy to .env.local and fill in values.

# Postgres connection string (required).
DATABASE_URL=postgres://kitsune:kitsune@localhost:5432/kitsune

# 16+ char random string used as the pepper for API-key secret hashing.
# Rotate only with a migration; changing this invalidates all issued keys.
API_KEY_PEPPER=change-me-to-a-long-random-value

# WorkOS AuthKit (admin auth).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Must exactly match the callback route in this app, e.g.
#   http://localhost:3000/api/auth/callback
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# 32+ char random string used to seal the AuthKit session cookie.
WORKOS_COOKIE_PASSWORD=change-me-to-a-long-random-string-at-least-32-chars

# Optional: S3-compatible storage for asset uploads (Cloudflare R2, AWS S3, etc.)
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# Optional: Sentry release/source map upload during `vite build`
# SENTRY_AUTH_TOKEN=

# Optional client observability
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=
